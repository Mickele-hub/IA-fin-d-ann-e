    {
      "parameters": {
        "jsCode": "// Normalisation vers le contrat d'interface : titre, description, date, lien, source\nconst SOURCES = {\n  'thehackernews.com': 'The Hacker News',\n  'arxiv.org': 'arXiv cs.AI',\n  'aws.amazon.com': 'AWS News Blog',\n  'dev.to': 'Dev.to',\n  'huggingface.co': 'Hugging Face',\n};\n\nconst clean = (s) => (s || '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const lien = (j.link || '').trim();\n  const titre = clean(j.title);\n  if (!titre || !lien) continue;\n\n  const m = lien.match(/^https?:\\/\\/([^\\/?#:]+)/i);\n  const host = m ? m[1].toLowerCase().replace(/^www\\./, '') : '';\n  const key = Object.keys(SOURCES).find((k) => host.endsWith(k));\n  const source = key ? SOURCES[key] : (host || 'Inconnue');\n\n  let date = new Date(j.isoDate || j.pubDate || Date.now());\n  if (isNaN(date.getTime())) date = new Date();\n\n  const description = clean(j.contentSnippet || j.content || j.description || '').slice(0, 1000);\n\n  out.push({ json: { titre, description, date: date.toISOString(), lien, source } });\n}\n// Suppression des doublons exacts (même lien)\nconst vus = new Set();\nconst uniques = out.filter((o) => {\n  if (vus.has(o.json.lien)) return false;\n  vus.add(o.json.lien);\n  return true;\n});\n\n// Garder les 30 articles les plus récents par source\nconst MAX_PAR_SOURCE = 30;\nconst parSource = {};\nfor (const o of uniques) (parSource[o.json.source] = parSource[o.json.source] || []).push(o);\nconst final = [];\nfor (const liste of Object.values(parSource)) {\n  liste.sort((a, b) => new Date(b.json.date) - new Date(a.json.date));\n  final.push(...liste.slice(0, MAX_PAR_SOURCE));\n}\nreturn final;\n"
      },
